{
  "filename": "napoleon.html",
  "title": "Napoleon's theorem / 拿破仑定理",
  "commands": [
    "A=(0.5,0.55)",
    "B=(5.1,0.35)",
    "C=(2.15,3.55)",
    "tri=Polygon(A,B,C)",
    "SetColor(tri,\"#94A3B8\")",
    "SetFilling(tri,0.08)",
    "Fc=Rotate(B,-pi/3,A)",
    "Fa=Rotate(C,-pi/3,B)",
    "Fb=Rotate(A,-pi/3,C)",
    "eqAB=Polygon(A,B,Fc)",
    "eqBC=Polygon(B,C,Fa)",
    "eqCA=Polygon(C,A,Fb)",
    "SetColor(eqAB,\"#C97B84\")",
    "SetFilling(eqAB,0.2)",
    "SetColor(eqBC,\"#6B9AC4\")",
    "SetFilling(eqBC,0.2)",
    "SetColor(eqCA,\"#D4A84B\")",
    "SetFilling(eqCA,0.2)",
    "Nc=(A+B+Fc)/3",
    "Na=(B+C+Fa)/3",
    "Nb=(C+A+Fb)/3",
    "napoleon=Polygon(Na,Nb,Nc)",
    "SetColor(napoleon,\"#2F6F5E\")",
    "SetFilling(napoleon,0.28)",
    "SetLineThickness(napoleon,3)",
    "SetColor(Na,\"#2F6F5E\")",
    "SetColor(Nb,\"#2F6F5E\")",
    "SetColor(Nc,\"#2F6F5E\")",
    "SetPointSize(Na,5)",
    "SetPointSize(Nb,5)",
    "SetPointSize(Nc,5)",
    "SetPointSize(A,4)",
    "SetPointSize(B,4)",
    "SetPointSize(C,4)",
    "SetVisibleInView(a,-1,false)",
    "SetVisibleInView(b,-1,false)",
    "SetVisibleInView(c,-1,false)",
    "ZoomIn(-1.8,-2.0,7.0,5.8)"
  ],
  "visibleLabels": ["A", "B", "C", "Na", "Nb", "Nc"],
  "captionOverrides": {
    "Na": "$N_A$",
    "Nb": "$N_B$",
    "Nc": "$N_C$"
  },
  "showAxes": false
}
