{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "geogebra-studio",
  "version": "0.5.0",
  "description": "Portable Agent Skill for editable GeoGebra HTML constructions and geometry source exports",
  "author": {
    "name": "YZDame"
  },
  "repository": "https://github.com/YZDame/GeoGebra-Studio",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "geogebra",
    "mathematics",
    "visualization",
    "ai-tools",
    "educational-technology",
    "mathematical-modeling",
    "agent-skills",
    "agent-plugins"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/geogebra-studio/SKILL.md",
      "interface": {
        "displayName": "GeoGebra Studio",
        "shortDescription": "Portable editable geometry skill",
        "developerName": "YZDame",
        "category": "Education",
        "composerIcon": "./assets/geogebra-icon.png",
        "logo": "./assets/geogebra-icon.png",
        "defaultPrompt": [
          "Create an editable GeoGebra HTML construction and open it in my browser."
        ]
      }
    }
  }
}
