{
  "name": "@lydt/geogebra-studio",
  "version": "0.5.0",
  "description": "Portable Agent Skill for editable GeoGebra HTML constructions and geometry source exports",
  "main": "dist/index.js",
  "private": false,
  "bin": {
    "geogebra-studio": "dist/cli.js",
    "gikz": "gikz/cli.cjs"
  },
  "files": [
    "dist/**/*",
    "package.json",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "assets/**/*",
    "plugin.json",
    ".codex-plugin/plugin.json",
    "skills/**/*",
    "docs/**/*",
    "gikz/**/*",
    "LICENSE-MIT",
    "THIRD_PARTY_NOTICES.md",
    "README.zh-CN.md",
    ".agents/plugins/marketplace.json",
    "examples/tangent-construction.json",
    "examples/cube-3d.json",
    "src/**/*",
    "tsconfig.json",
    "scripts/build-plugin.cjs",
    "viewer/**/*",
    "examples/right-triangle.json",
    "README.zh-TW.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc && node scripts/build-plugin.cjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "verify": "npm run build && npm run verify:manifests && node scripts/verify-generator.cjs && node scripts/verify-skill.cjs && node scripts/verify-exports.cjs",
    "verify:manifests": "node scripts/verify-manifests.cjs",
    "test:unit": "jest --runInBand --runTestsByPath tests/unit/semantic-export.test.ts tests/unit/studio-artifact.test.ts tests/unit/viewer-3d.test.ts tests/unit/viewer-action-commands.test.ts tests/unit/viewer-command-executor.test.ts tests/unit/viewer-style-commands.test.ts tests/unit/geogebra-instance.test.ts",
    "verify:math": "node scripts/verify-math.cjs",
    "verify:3d": "node scripts/verify-viewer-3d.cjs",
    "release:artifacts": "npm run verify && npm run test:unit && node scripts/package-release.cjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "geogebra",
    "mathematics",
    "visualization",
    "ai-tools",
    "educational-technology",
    "mathematical-modeling",
    "agent-skills",
    "agent-plugins"
  ],
  "author": "YZDame",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/YZDame/GeoGebra-Studio.git"
  },
  "homepage": "https://github.com/YZDame/GeoGebra-Studio#readme",
  "bugs": {
    "url": "https://github.com/YZDame/GeoGebra-Studio/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "winston": "^3.11.0",
    "puppeteer-core": "25.13.0",
    "@puppeteer/browsers": "3.2.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch": "^9.0.7"
  }
}
