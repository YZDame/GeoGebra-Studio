{
  "name": "@lydt/geogebra-studio",
  "version": "0.4.0",
  "description": "GeoGebra Studio: editable HTML geometry in the Codex browser, agent skills and built-in Gikz; optional MCP automation",
  "main": "dist/index.js",
  "private": false,
  "bin": {
    "geogebra-studio": "dist/cli.js",
    "geogebra-mcp": "dist/cli.js",
    "gikz": "gikz/cli.cjs"
  },
  "files": [
    "dist/**/*",
    "runtime/package.json",
    "package.json",
    "README.md",
    "LICENSE",
    "assets/**/*",
    "plugin.json",
    "mcp.json",
    ".codex-plugin/plugin.json",
    ".mcp.json",
    "skills/**/*",
    "docs/**/*",
    "widget/**/*",
    "scripts/build-widget.cjs",
    "gikz/**/*",
    "LICENSE-MIT",
    "THIRD_PARTY_NOTICES.md",
    "README.zh-CN.md",
    ".agents/plugins/marketplace.json",
    "examples/tangent-construction.json",
    "src/**/*",
    "tsconfig.json",
    "scripts/build-plugin.cjs",
    "viewer/**/*",
    "mcp.optional.json"
  ],
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "npm run clean && tsc && node scripts/build-widget.cjs && node scripts/build-plugin.cjs",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "prepublishOnly": "npm run build",
    "verify": "npm run build && npm run verify:manifests && node scripts/verify-generator.cjs",
    "verify:native": "node scripts/verify-native.cjs",
    "test:unit": "jest --runInBand --testPathIgnorePatterns tests/e2e tests/performance tests/real-geogebra tests/geogebra-integration",
    "release:artifacts": "npm run verify && npm run test:unit && node scripts/package-release.cjs",
    "verify:manifests": "node scripts/verify-manifests.cjs",
    "verify:mcp": "node scripts/verify-protocol.cjs && node scripts/verify-exports.cjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "geogebra",
    "mathematics",
    "visualization",
    "ai-tools",
    "educational-technology",
    "mathematical-modeling"
  ],
  "author": "YZDame",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/YZDame/GeoGebra-Studio.git"
  },
  "homepage": "https://github.com/YZDame/GeoGebra-Studio#readme",
  "bugs": {
    "url": "https://github.com/YZDame/GeoGebra-Studio/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "dotenv": "^16.3.1",
    "fast-xml-parser": "^5.11.2",
    "winston": "^3.11.0",
    "puppeteer-core": "25.13.0",
    "@puppeteer/browsers": "3.2.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch": "^9.0.7"
  }
}
