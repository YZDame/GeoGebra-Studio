{
  "name": "dsh-geogebra-studio",
  "version": "0.3.2",
  "description": "DeepSeek Harness plugin with a left-rail GeoGebra Studio entry and a live right-side GeoGebra canvas, plus build, preview and export tools and the geogebra-studio skill. Unofficial and not affiliated with GeoGebra.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "runtime/",
    "skills/",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!**/* [0-9].*",
    "!**/* [0-9]"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "verify": "node scripts/verify.mjs",
    "prepack": "node scripts/clean-conflict-copies.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YZDame/GeoGebra-Studio.git",
    "directory": "plugins/dsh-geogebra-studio"
  },
  "homepage": "https://github.com/YZDame/GeoGebra-Studio#readme",
  "bugs": {
    "url": "https://github.com/YZDame/GeoGebra-Studio/issues"
  },
  "author": "YZDame",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "geogebra",
    "geometry",
    "mathematics"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
