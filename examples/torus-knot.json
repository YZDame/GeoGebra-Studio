{
  "filename": "torus-knot.html",
  "title": "T(p,q) torus knot / PQ 环面结",
  "commands": [
    "p=Slider(1,7,1,1,140,false,true,false,false)",
    "SetValue(p,2)",
    "q=Slider(1,7,1,1,140,false,true,false,false)",
    "SetValue(q,3)",
    "torus=Surface((2.2+0.75cos(v))cos(u),(2.2+0.75cos(v))sin(u),0.75sin(v),u,0,2pi,v,0,2pi)",
    "knot=Curve((2.2+0.75cos(q*t))cos(p*t),(2.2+0.75cos(q*t))sin(p*t),0.75sin(q*t),t,0,2pi/GCD(p,q))",
    "SetColor(torus,\"#386E98\")",
    "SetFilling(torus,0.15)",
    "SetColor(knot,\"#B35A4C\")",
    "SetLineThickness(knot,5)"
  ],
  "visibleLabels": [],
  "showAxes": false,
  "mode": "3D",
